{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-architecture/capability-plan",
  "title": "Read plan and bindings; not execution or validation success",
  "type": "object",
  "required": ["version", "project_root", "planning_only", "status", "selected", "unmet", "unknown", "errors", "warnings", "inputs", "fingerprint", "delta", "active_requirements", "normalized_context", "architecture_snapshot", "architecture_sha256"],
  "properties": {
    "version": {"const": 1},
    "project_root": {"type": "string", "minLength": 1},
    "planning_only": {"const": true},
    "status": {"enum": ["planned", "unknown", "invalid"]},
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "capability_type", "source", "read_files", "reason", "node_ids", "read_scope", "write_scope", "allowed_writeback"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "capability_type": {"type": "string", "minLength": 1},
          "source": {"enum": ["skill", "reference"]},
          "read_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
          "reason": {"$ref": "#/$defs/strings"},
          "node_ids": {"$ref": "#/$defs/strings"},
          "read_scope": {"$ref": "#/$defs/strings"},
          "write_scope": {"$ref": "#/$defs/strings"},
          "declared_write_scope": {"$ref": "#/$defs/strings"},
          "allowed_writeback": {"$ref": "#/$defs/strings"},
          "covers_risks": {"$ref": "#/$defs/strings"}
        }
      }
    },
    "unmet": {"$ref": "#/$defs/strings"},
    "unknown": {"$ref": "#/$defs/strings"},
    "errors": {"$ref": "#/$defs/strings"},
    "warnings": {"$ref": "#/$defs/strings"},
    "fingerprint": {"$ref": "#/$defs/hash"},
    "architecture_sha256": {"$ref": "#/$defs/hash"},
    "architecture_snapshot": {"type": ["object", "null"]},
    "inputs": {"type": "object", "required": ["context", "catalog", "architecture", "index_sha256", "normalized_context_sha256"]},
    "delta": {"type": "object", "required": ["added", "retained", "retired"], "properties": {"added": {"$ref": "#/$defs/strings"}, "retained": {"$ref": "#/$defs/strings"}, "retired": {"$ref": "#/$defs/strings"}}},
    "active_requirements": {"type": "object", "required": ["required_capabilities", "required_risks"]},
    "normalized_context": {"type": "object"}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "origin", "declared_root"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0}, "origin": {"enum": ["project", "catalog"]}, "declared_root": {"type": "string", "minLength": 1}, "encoding": {"type": "string"}}
    }
  }
}
