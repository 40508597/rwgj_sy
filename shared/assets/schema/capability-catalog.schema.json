{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-architecture/capability-catalog",
  "title": "Explicit local capability registry, not an installer",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": {"const": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "能力类型", "source", "root", "entry"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "能力类型": {"type": "string", "minLength": 1},
          "source": {"enum": ["skill", "reference"]},
          "root": {"type": "string", "minLength": 1},
          "entry": {"type": "string", "minLength": 1},
          "refs": {"$ref": "#/$defs/strings"},
          "project_override": {"type": "boolean"},
          "priority": {"type": "integer"},
          "requires": {"$ref": "#/$defs/conditions"},
          "covers_risks": {"$ref": "#/$defs/strings"},
          "node_ids": {"$ref": "#/$defs/strings"},
          "read_scope": {"$ref": "#/$defs/strings"},
          "write_scope": {"$ref": "#/$defs/strings"},
          "allowed_writeback": {"$ref": "#/$defs/strings"},
          "encoding": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonempty": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stages": {"$ref": "#/$defs/nonempty"},
        "tiers": {"$ref": "#/$defs/nonempty"},
        "risks": {"$ref": "#/$defs/nonempty"},
        "module_ids": {"$ref": "#/$defs/nonempty"},
        "confirmed_capabilities": {"$ref": "#/$defs/nonempty"},
        "professional_domains": {"$ref": "#/$defs/nonempty"},
        "execution_roles": {"$ref": "#/$defs/nonempty"},
        "task_scenarios": {"$ref": "#/$defs/nonempty"},
        "runtime": {"$ref": "#/$defs/nonempty"},
        "deliverables": {"$ref": "#/$defs/nonempty"},
        "integrations": {"$ref": "#/$defs/nonempty"},
        "context_equals": {"type": "object", "minProperties": 1},
        "any_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conditions"}}
      }
    }
  }
}
