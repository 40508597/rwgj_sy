{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.task-architecture/architecture.schema.json",
  "标题": "任务架构 architecture.json 结构底线",
  "说明": "本 schema 只约束 architecture.json 的顶层中文字段和关键容器类型；完整工程语义仍以 SKILL.md、references/ 和 21 项一致性校验为准。",
  "type": "object",
  "required": [
    "项目",
    "运行形态",
    "功能树",
    "专业能力索引",
    "入口",
    "模块拓扑",
    "模块树",
    "模块详情",
    "页面拓扑",
    "数据拓扑",
    "交付物",
    "系统集成",
    "接口契约",
    "实现清单",
    "完整细节",
    "测试责任矩阵",
    "验证证据",
    "架构切片",
    "上下文恢复点",
    "未决问题",
    "变更记录"
  ],
  "properties": {
    "项目": {"type": "object"},
    "运行形态": {"type": "array"},
    "功能树": {"type": "array"},
    "专业能力索引": {"type": "array"},
    "入口": {
      "type": "object",
      "required": ["用户入口", "接口入口", "命令入口", "事件入口", "系统入口", "资源入口"],
      "properties": {
        "用户入口": {"type": "array"},
        "接口入口": {"type": "array"},
        "命令入口": {"type": "array"},
        "事件入口": {"type": "array"},
        "系统入口": {"type": "array"},
        "资源入口": {"type": "array"}
      }
    },
    "模块拓扑": {
      "type": "object",
      "required": ["节点", "依赖图"],
      "properties": {
        "节点": {"type": "array"},
        "依赖图": {"type": "array"}
      }
    },
    "模块树": {"type": "array"},
    "模块详情": {"type": "object"},
    "页面拓扑": {"type": "array"},
    "数据拓扑": {"type": "array"},
    "交付物": {"type": "array"},
    "系统集成": {"type": "array"},
    "接口契约": {"type": "object"},
    "实现清单": {"type": "object"},
    "完整细节": {"type": "object"},
    "测试责任矩阵": {"type": "array"},
    "验证证据": {
      "type": "object",
      "properties": {
        "自动化测试": {"type": "array"},
        "架构校验": {"type": "array"},
        "浏览器验收": {"type": "array"},
        "截图": {"type": "array"},
        "手动检查": {"type": "array"},
        "未验证项": {"type": "array"}
      }
    },
    "架构切片": {
      "type": "object",
      "properties": {
        "启用": {"type": "boolean"},
        "架构模式": {"type": "string"},
        "总索引文件": {"type": "string"},
        "根入口文件": {"type": "string"},
        "切片目录": {"type": "string"},
        "切片清单": {"type": "array"},
        "同步规则": {"type": "array"}
      }
    },
    "上下文恢复点": {"type": "object"},
    "未决问题": {"type": "array"},
    "变更记录": {"type": "array"}
  }
}
